<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:layoutDirection="rtl"
    android:background="@color/bg"
    android:paddingLeft="20dp"
    android:paddingRight="20dp"
    android:paddingTop="20dp">

    <!-- ===== Header (always visible) ===== -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:layout_marginBottom="16dp">
        <ImageView
            android:layout_width="30dp"
            android:layout_height="30dp"
            android:src="@mipmap/ic_launcher"
            android:layout_marginEnd="10dp" />
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="ארלוזרוב אוטומטי"
            android:textColor="@color/text_primary"
            android:textSize="22sp"
            android:textStyle="bold" />
    </LinearLayout>

    <!-- ===== Login section (shown when logged out) ===== -->
    <LinearLayout
        android:id="@+id/login_section"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:background="@drawable/bg_card"
        android:padding="20dp"
        android:visibility="visible">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="התחברות"
            android:textColor="@color/text_primary"
            android:textSize="16sp"
            android:textStyle="bold"
            android:layout_marginBottom="4dp" />
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="יש להזין את מספר הטלפון של חשבון פיזיקל שלך."
            android:textColor="@color/text_muted"
            android:textSize="12sp"
            android:layout_marginBottom="14dp" />
        <EditText
            android:id="@+id/phone_input"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="מספר טלפון"
            android:inputType="phone"
            android:background="@drawable/bg_input"
            android:textColor="@color/text_primary"
            android:textColorHint="@color/text_muted"
            android:textCursorDrawable="@null" />
        <Button
            android:id="@+id/send_otp_button"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="שליחת קוד"
            android:textColor="#ffffff"
            android:textAllCaps="false"
            android:textStyle="bold"
            android:background="@drawable/bg_button_primary"
            android:paddingLeft="20dp" android:paddingRight="20dp"
            android:paddingTop="10dp" android:paddingBottom="10dp"
            android:minWidth="0dp" android:minHeight="0dp"
            android:layout_marginTop="14dp" />
        <EditText
            android:id="@+id/code_input"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="קוד מ-SMS"
            android:inputType="number"
            android:background="@drawable/bg_input"
            android:textColor="@color/text_primary"
            android:textColorHint="@color/text_muted"
            android:textCursorDrawable="@null"
            android:visibility="gone"
            android:layout_marginTop="18dp" />
        <Button
            android:id="@+id/verify_otp_button"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="אימות"
            android:textColor="#ffffff"
            android:textAllCaps="false"
            android:textStyle="bold"
            android:background="@drawable/bg_button_primary"
            android:paddingLeft="20dp" android:paddingRight="20dp"
            android:paddingTop="10dp" android:paddingBottom="10dp"
            android:minWidth="0dp" android:minHeight="0dp"
            android:visibility="gone"
            android:layout_marginTop="14dp" />
        <TextView
            android:id="@+id/login_error"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textColor="@color/err"
            android:textSize="13sp"
            android:layout_marginTop="12dp" />
    </LinearLayout>

    <!-- ===== Content area (one screen visible at a time) ===== -->
    <FrameLayout
        android:id="@+id/content_area"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:visibility="gone">

        <!-- == Screen 1: שיעורים (classes) == -->
        <LinearLayout
            android:id="@+id/screen_classes"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical">
                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="שיעורים קרובים"
                    android:textColor="@color/text_muted"
                    android:textStyle="bold"
                    android:textSize="12sp"
                    android:letterSpacing="0.06" />
                <Button
                    android:id="@+id/refresh_button"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="רענון"
                    android:textColor="@color/text_primary"
                    android:textAllCaps="false"
                    android:textSize="13sp"
                    android:background="@drawable/bg_button_secondary"
                    android:paddingLeft="14dp" android:paddingRight="14dp"
                    android:paddingTop="8dp" android:paddingBottom="8dp"
                    android:minWidth="0dp" android:minHeight="0dp" />
            </LinearLayout>

            <HorizontalScrollView
                android:id="@+id/day_tabs_scroll"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:scrollbars="none"
                android:layout_marginTop="10dp">
                <LinearLayout
                    android:id="@+id/day_tabs_container"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal" />
            </HorizontalScrollView>

            <TextView
                android:id="@+id/classes_error"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textColor="@color/text_muted"
                android:textSize="13sp"
                android:layout_marginTop="6dp" />

            <ListView
                android:id="@+id/classes_list"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:divider="@android:color/transparent"
                android:dividerHeight="8dp"
                android:layout_marginTop="8dp"
                android:clipToPadding="false" />
        </LinearLayout>

        <!-- == Screen 2: ההרשמות שלי (registrations) == -->
        <LinearLayout
            android:id="@+id/screen_registrations"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical"
            android:visibility="gone">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginBottom="12dp">
                <Button
                    android:id="@+id/seg_pending"
                    android:layout_width="0dp" android:layout_weight="1"
                    android:layout_height="wrap_content"
                    android:text="מתוזמן"
                    android:textColor="#ffffff"
                    android:textAllCaps="false" android:textStyle="bold" android:textSize="14sp"
                    android:background="@drawable/bg_button_primary"
                    android:paddingTop="10dp" android:paddingBottom="10dp"
                    android:minWidth="0dp" android:minHeight="0dp"
                    android:layout_marginEnd="6dp" />
                <Button
                    android:id="@+id/seg_registered"
                    android:layout_width="0dp" android:layout_weight="1"
                    android:layout_height="wrap_content"
                    android:text="רשום"
                    android:textColor="@color/text_primary"
                    android:textAllCaps="false" android:textSize="14sp"
                    android:background="@drawable/bg_button_secondary"
                    android:paddingTop="10dp" android:paddingBottom="10dp"
                    android:minWidth="0dp" android:minHeight="0dp"
                    android:layout_marginEnd="6dp" />
                <Button
                    android:id="@+id/seg_recurring"
                    android:layout_width="0dp" android:layout_weight="1"
                    android:layout_height="wrap_content"
                    android:text="קבוע"
                    android:textColor="@color/text_primary"
                    android:textAllCaps="false" android:textSize="14sp"
                    android:background="@drawable/bg_button_secondary"
                    android:paddingTop="10dp" android:paddingBottom="10dp"
                    android:minWidth="0dp" android:minHeight="0dp" />
            </LinearLayout>

            <TextView
                android:id="@+id/scheduled_empty"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textColor="@color/text_muted"
                android:textSize="14sp"
                android:layout_marginTop="20dp"
                android:visibility="gone" />

            <ListView
                android:id="@+id/scheduled_list"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:divider="@android:color/transparent"
                android:dividerHeight="8dp"
                android:clipToPadding="false" />
        </LinearLayout>

        <!-- == Screen 3: חשבון (account) == -->
        <LinearLayout
            android:id="@+id/screen_account"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical"
            android:visibility="gone">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:background="@drawable/bg_card"
                android:padding="18dp">
                <TextView
                    android:id="@+id/phone_display"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:textColor="@color/text_primary"
                    android:textSize="16sp"
                    android:textStyle="bold"
                    android:layout_marginBottom="16dp" />
                <Button
                    android:id="@+id/qr_entry_button"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="כרטיס כניסה"
                    android:textColor="#ffffff"
                    android:textAllCaps="false" android:textStyle="bold"
                    android:background="@drawable/bg_button_primary"
                    android:paddingTop="12dp" android:paddingBottom="12dp"
                    android:minWidth="0dp" android:minHeight="0dp"
                    android:layout_marginBottom="10dp" />
                <Button
                    android:id="@+id/reverify_button"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="התחבר מחדש"
                    android:textColor="#ffffff"
                    android:textAllCaps="false" android:textStyle="bold"
                    android:background="@drawable/bg_button_primary"
                    android:paddingTop="12dp" android:paddingBottom="12dp"
                    android:minWidth="0dp" android:minHeight="0dp"
                    android:layout_marginBottom="10dp" />
                <Button
                    android:id="@+id/logout_button"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="התנתקות"
                    android:textColor="@color/text_primary"
                    android:textAllCaps="false"
                    android:background="@drawable/bg_button_secondary"
                    android:paddingTop="12dp" android:paddingBottom="12dp"
                    android:minWidth="0dp" android:minHeight="0dp" />
            </LinearLayout>

            <TextView
                android:id="@+id/alarm_warning"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="⚠ יש לאשר כאן ‘התראות ותזכורות’ כדי שההרשמה תתבצע בזמן."
                android:textColor="@color/warn"
                android:textSize="13sp"
                android:background="@drawable/badge_orange"
                android:padding="12dp"
                android:layout_marginTop="14dp"
                android:visibility="gone" />
        </LinearLayout>
    </FrameLayout>

    <!-- ===== Bottom navigation (shown when logged in) ===== -->
    <LinearLayout
        android:id="@+id/bottom_nav"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:paddingTop="8dp"
        android:paddingBottom="8dp"
        android:visibility="gone">
        <Button
            android:id="@+id/nav_classes"
            android:layout_width="0dp" android:layout_weight="1"
            android:layout_height="wrap_content"
            android:text="שיעורים"
            android:textColor="@color/accent"
            android:textAllCaps="false" android:textStyle="bold" android:textSize="14sp"
            android:background="@android:color/transparent"
            android:minWidth="0dp" android:minHeight="0dp" />
        <Button
            android:id="@+id/nav_registrations"
            android:layout_width="0dp" android:layout_weight="1"
            android:layout_height="wrap_content"
            android:text="ההרשמות שלי"
            android:textColor="@color/text_muted"
            android:textAllCaps="false" android:textSize="14sp"
            android:background="@android:color/transparent"
            android:minWidth="0dp" android:minHeight="0dp" />
        <Button
            android:id="@+id/nav_account"
            android:layout_width="0dp" android:layout_weight="1"
            android:layout_height="wrap_content"
            android:text="חשבון"
            android:textColor="@color/text_muted"
            android:textAllCaps="false" android:textSize="14sp"
            android:background="@android:color/transparent"
            android:minWidth="0dp" android:minHeight="0dp" />
    </LinearLayout>

</LinearLayout>
